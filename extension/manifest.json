{
  "manifest_version": 3,
  "name": "JP Card Watcher — Cardmarket bridge",
  "version": "1.0.0",
  "description": "Lets the JP Card Watcher dashboard read Cardmarket offer pages using your own logged-in browser session.",
  "host_permissions": ["*://*.cardmarket.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://paludancode.github.io/MTG-Pricerunner/*",
        "https://*.web.core.windows.net/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
